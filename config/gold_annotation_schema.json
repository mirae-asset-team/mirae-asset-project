{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "miraeasset-disclosure-gold-annotation-v0.1.0",
  "title": "Human-reviewed disclosure QA Gold record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "question_id",
    "question_type",
    "question",
    "answerability",
    "answer",
    "answer_origin",
    "candidate_filing_ids",
    "company_resolution",
    "period",
    "scope",
    "as_of",
    "version_basis",
    "formula",
    "attack_label",
    "evidence",
    "version_evidence",
    "source_evidence",
    "review"
  ],
  "properties": {
    "schema_version": {"const": "0.1.0"},
    "question_id": {"type": "string", "minLength": 1},
    "question_type": {
      "enum": [
        "single_filing_fact",
        "table_cell",
        "period_comparison",
        "cross_company_comparison",
        "correction_aware",
        "multi_filing_synthesis",
        "unanswerable",
        "adversarial"
      ]
    },
    "question": {"type": "string", "minLength": 1},
    "answerability": {"enum": ["answerable", "unanswerable", "ambiguous"]},
    "answer": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "text"],
          "properties": {"kind": {"const": "text"}, "text": {"type": "string", "minLength": 1}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value", "unit", "scale"],
          "properties": {
            "kind": {"const": "numeric"},
            "value": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
            "unit": {"type": "string", "minLength": 1},
            "scale": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "values"],
          "properties": {
            "kind": {"const": "multi_numeric"},
            "values": {
              "type": "array",
              "minItems": 2,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["label", "value", "unit", "scale", "evidence_ids"],
                "properties": {
                  "label": {"type": "string", "minLength": 1},
                  "value": {"type": "string", "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
                  "unit": {"type": "string", "minLength": 1},
                  "scale": {"type": "integer", "minimum": 1},
                  "evidence_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "reason"],
          "properties": {"kind": {"const": "unanswerable"}, "reason": {"type": "string", "minLength": 1}}
        }
      ]
    },
    "answer_origin": {"enum": ["model_generated", "human_verified"]},
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "generator", "base_sha256"],
      "properties": {
        "state": {"enum": ["candidate", "agent_audited", "human_verified", "rejected"]},
        "generator": {"type": "string", "minLength": 1},
        "base_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "gold_input_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "seed_input_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "candidate_filing_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9]{14}$"}},
    "company_resolution": {
      "type": ["object", "null"],
      "properties": {
        "query_name": {"type": "string"},
        "issuer_name": {"type": "string"},
        "corp_code": {"type": ["string", "null"]},
        "stock_code": {"type": ["string", "null"]}
      },
      "required": ["query_name", "issuer_name"],
      "additionalProperties": false
    },
    "period": {
      "type": "object",
      "properties": {
        "period_type": {"enum": ["instant", "duration", "event_date", "not_applicable"]},
        "start_date": {"type": ["string", "null"], "format": "date"},
        "end_date": {"type": ["string", "null"], "format": "date"},
        "instant_date": {"type": ["string", "null"], "format": "date"}
      },
      "required": ["period_type", "start_date", "end_date", "instant_date"],
      "additionalProperties": false
    },
    "scope": {"enum": ["consolidated", "separate", "not_applicable"]},
    "as_of": {"type": ["string", "null"], "format": "date"},
    "version_basis": {"enum": ["latest_effective", "as_of", "not_applicable"]},
    "formula": {
      "type": ["object", "null"],
      "properties": {
        "expression": {"type": "string"},
        "operand_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "expected_result": {"type": ["number", "null"]},
        "unit": {"type": ["string", "null"]},
        "scale": {"type": ["integer", "null"]}
      },
      "required": ["expression", "operand_evidence_ids", "expected_result", "unit", "scale"],
      "additionalProperties": false
    },
    "attack_label": {"type": ["string", "null"]},
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["evidence_id", "filing_id", "source_sha256", "locator", "role", "lineage_status", "is_current", "effective_from", "effective_to", "source_format", "table_structure_status"],
        "properties": {
          "evidence_id": {"type": "string", "minLength": 1},
          "filing_id": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "locator": {"type": "object"},
          "role": {"enum": ["support", "operand", "version_before", "version_after", "distractor"]},
          "lineage_status": {"enum": ["root", "resolved", "unresolved", "missing_original"]},
          "is_current": {"type": "boolean"},
          "effective_from": {"type": ["string", "null"], "format": "date"},
          "effective_to": {"type": ["string", "null"], "format": "date"},
          "source_format": {"enum": ["xml", "html", "pdf", "other"]},
          "table_structure_status": {"enum": ["human_validated", "parsed_unreviewed", "unvalidated", "not_applicable"]},
          "table_id": {"type": ["string", "null"]},
          "cell_evidence_id": {"type": ["string", "null"]},
          "unit": {"type": ["string", "null"]},
          "scale": {"type": ["integer", "null"]}
        }
      }
    },
    "version_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["filing_id", "event_id", "parent_filing_id", "lineage_status", "lineage_confidence", "is_current", "effective_from", "effective_to", "rationale"],
        "properties": {
          "filing_id": {"type": "string", "pattern": "^[0-9]{14}$"},
          "event_id": {"type": "string", "minLength": 1},
          "parent_filing_id": {"type": ["string", "null"]},
          "lineage_status": {"enum": ["root", "resolved", "unresolved", "missing_original"]},
          "lineage_confidence": {"type": "string"},
          "is_current": {"type": "boolean"},
          "effective_from": {"type": ["string", "null"], "format": "date"},
          "effective_to": {"type": ["string", "null"], "format": "date"},
          "rationale": {"type": "string"}
        }
      }
    },
    "source_evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "filing_id", "sha256", "detected_format", "parse_status", "fragment_count", "table_count", "cell_count", "table_structure_status"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "filing_id": {"type": "string", "pattern": "^[0-9]{14}$"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "detected_format": {"type": "string"},
          "parse_status": {"type": "string"},
          "fragment_count": {"type": "integer", "minimum": 0},
          "table_count": {"type": "integer", "minimum": 0},
          "cell_count": {"type": "integer", "minimum": 0},
          "table_structure_status": {"enum": ["parsed_unreviewed", "unvalidated", "not_applicable"]}
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "annotator", "reviewer", "reviewed_at", "notes"],
      "properties": {
        "status": {"enum": ["candidate", "agent_audited", "reviewed", "approved", "rejected"]},
        "annotator": {"type": "string", "minLength": 1},
        "reviewer": {"type": ["string", "null"]},
        "reviewed_at": {"type": ["string", "null"], "format": "date-time"},
        "notes": {"type": "string"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"answer_origin": {"const": "model_generated"}}},
      "then": {"properties": {"review": {"properties": {"status": {"const": "candidate"}}}}}
    },
    {
      "if": {"properties": {"review": {"properties": {"status": {"const": "approved"}}}}},
      "then": {
        "properties": {
          "answer_origin": {"const": "human_verified"},
          "review": {"properties": {"reviewer": {"type": "string", "minLength": 1}, "reviewed_at": {"type": "string", "format": "date-time"}}}
        }
      }
    }
  ]
}
